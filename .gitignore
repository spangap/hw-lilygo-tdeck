*.bak
.DS_Store
._*
build*/
build.lock
.claude/
managed_components/
dependencies.lock
# spangap CLI stages required straddles here as symlinks pre-build (picked up
# via EXTRA_COMPONENT_DIRS). Always regenerated; never edit by hand.
staging/
sdkconfig
sdkconfig.old
# sdkconfig.defaults is LOCAL SCRATCH only — deliberately NOT committed (this
# inverts ESP-IDF's usual "commit your defaults" convention). What a straddle
# DISTRIBUTES it declares explicitly in straddle.yaml `kconfig:`, which is
# collected for every staged straddle. A committed defaults file would be a
# trap: in a non-buildable straddle it is never read at all, and even in a
# buildable it hides config that should be visible in the manifest. Use it to
# experiment with `spangap menuconfig` / save-defconfig, then promote the lines
# you want to keep into `kconfig:`.
sdkconfig.defaults
sdkconfig.defaults.*
partitions.csv
web-interface/node_modules/
web-interface/dist/
web-interface/.quasar/
data/build_times

# Local dev only (untracked): quick bring-up after factory reset — TLS + WiFi + built web
data/config.json
data/factory_state/tls_cert.pem
data/factory_state/tls_key.pem
data/webroot/

# Local dev overlay — WiFi creds, TLS certs, etc. (merged on first boot)
data/additional_state/

*.pcap

# OTA signing — private key (.pem) never committed; public key as a C
# header (main/ota_pubkey.h) is committed so a clean checkout can verify.
keys/ota_priv.pem

# Harness install — cloned reference codebases + venv, regenerated by `make harness`
research/

# Dev-loop rnsd state — persists across firmware reflashes; nuke via `make rns-reset`
.rns/

# Auto-generated artifacts (added by maintenance sweep)
esp-idf/managed_components/
esp-idf/dependencies.lock
esp-idf/sdkconfig
esp-idf/sdkconfig.old
esp-idf/sdkconfig.defaults
esp-idf/sdkconfig.defaults.*
__pycache__/
*.pyc
*.pyo

# package-lock.json IS committed for buildable straddles — it pins the full
# browser dependency tree so the firmware's web build is reproducible for
# everyone. Library straddles ignore it (see their .gitignore); when a straddle
# becomes buildable, drop its package-lock ignore and commit the lock.
